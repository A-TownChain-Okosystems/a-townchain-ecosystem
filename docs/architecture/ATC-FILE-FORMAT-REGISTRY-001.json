{
  "schema_id": "ATC-FILE-FORMAT-REGISTRY-001",
  "schema_version": "1.0.0",
  "status": "BASELINE_RESIDUAL",
  "release_decision": "BLOCKED",
  "authority": {
    "purpose": "Inventory file formats and bind each format to canonical ownership, processing capabilities, security requirements, and catalog reconciliation.",
    "implementation_policy": "Standalone First, Ecosystem Second. This registry is control-plane metadata only; it must not host duplicate parsers, writers, runtimes, or format implementations.",
    "normative_owner": "A-TownChain-Okosystems/atc-standards",
    "catalog_ssot": "docs/architecture/ATC-COMPONENT-FUNCTION-CATALOG-001.json",
    "registry_owner": "A-TownChain-Okosystems/a-townchain-ecosystem"
  },
  "status_semantics": {
    "IMPLEMENTED": "Source implementation observed; not a claim of verification.",
    "VERIFIED": "Only with exact commit SHA and actual test evidence including run, job, step, exit code, and logs/artifacts.",
    "RESIDUAL": "Required format behavior or source mapping remains incomplete or unverified.",
    "BLOCKED": "A normative decision, dependency, or source binding prevents safe completion.",
    "EXCLUDED": "Explicitly out of scope with a recorded reason."
  },
