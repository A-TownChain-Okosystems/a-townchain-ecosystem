  "function_reconciliation": {
    "catalog_integration_required": true,
    "catalog_contracts_must_live_in": "docs/architecture/ATC-COMPONENT-FUNCTION-CATALOG-001.json",
    "required_capability_groups": [
      "format.detect",
      "format.parse",
      "format.validate",
      "format.serialize",
      "format.deserialize",
      "format.integrity.verify",
      "format.signature.verify",
      "format.migrate",
      "format.install",
      "format.rollback",
      "format.conformance.test"
    ],
    "minimum_function_contract_fields": [
      "stable_function_id",
      "canonical_owner_repo",
      "purpose",
      "inputs",
      "outputs",
      "preconditions",
      "failure_semantics",
      "resource_limits",
      "security_boundary",
      "source_binding.repository",
      "source_binding.full_commit_sha",
      "source_binding.path",
      "source_binding.symbol",
      "source_binding.blob_sha",
      "test_evidence"
    ],
    "status": "RESIDUAL",
    "note": "This registry is a format inventory and gap map, not a replacement for the catalog's function contracts. Add each proven or missing function to the existing catalog using its established IDs and schema. Do not claim source mapping from a format's existence."
  },
  "evidence_policy": {
    "source_binding_key": [
      "repository",
      "full_commit_sha",
      "path",
      "symbol",
      "blob_sha"
    ],
    "verified_requires": [
      "exact_commit_sha",
      "workflow_run_id",
      "job_id",
      "step_name",
      "exit_code_0",
      "log_or_artifact_digest",
      "scope_match"
    ],
    "pending_or_skipped_is_success": false,
    "structural_validation_is_functional_verification": false,
    "release_decision": "BLOCKED"
  }
