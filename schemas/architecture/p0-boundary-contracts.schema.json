{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://a-townchain.org/schemas/architecture/p0-boundary-contracts.schema.json",
  "title": "ATC P0 Boundary Contracts",
  "type": "object",
  "required": [
    "schema",
    "architecture_source",
    "status",
    "contracts"
  ],
  "properties": {
    "schema": {
      "const": "ATC-ARCH-P0-CONTRACTS-1.0"
    },
    "architecture_source": {
      "const": "ARCHITECTURE.md"
    },
    "status": {
      "const": "ACTIVE"
    },
    "contracts": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "authority",
          "deny_by_default",
          "canonical_owner"
        ],
        "properties": {
          "id": {
            "pattern": "^ARCH-P0-00[1-7]$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "authority": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "deny_by_default": {
            "const": true
          },
          "canonical_owner": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
